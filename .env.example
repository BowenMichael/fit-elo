# ─────────────────────────────────────────────────────────────────────────────
# Local Development Environment Defaults
# Copy this file to `.env` to override default settings for local development.
# ─────────────────────────────────────────────────────────────────────────────

# Server Port configuration
PORT=3001

# Application Node Environment
NODE_ENV=development

# Allowed CORS origins for the signaling server (comma separated)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# Client Expo connection URL to backend server
EXPO_PUBLIC_SERVER_URL=http://localhost:3001

# React Native / Metro Packager hostname for LAN Expo Go connections
# Set to your LAN IP (e.g., 192.168.1.50) if connecting physical mobile devices
REACT_NATIVE_PACKAGER_HOSTNAME=localhost

# Redis connection URL for caching and socket state
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
